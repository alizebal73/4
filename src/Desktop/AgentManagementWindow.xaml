<Window x:Class="GameNet.Desktop.AgentManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت Agent ها"
        Width="900"
        Height="600"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F7F8FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="16" CornerRadius="10"
                BorderBrush="#E1E5EB" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Device ID" FontWeight="SemiBold"/>
                    <TextBox x:Name="DeviceIdBox" Height="36" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="Pairing Code" FontWeight="SemiBold"/>
                    <TextBox x:Name="PairingCodeBox" Height="36" Margin="0,6,0,0"
                             IsReadOnly="True" HorizontalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Content="ساخت کد"
                        Width="110" Height="36"
                        VerticalAlignment="Bottom"
                        Click="CreatePairingCode_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White"
                    Padding="12" CornerRadius="10"
                    BorderBrush="#E1E5EB" BorderThickness="1">
                <ListBox x:Name="AgentsList"
                         SelectionChanged="AgentsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,8"
                                    BorderBrush="#E1E5EB" BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               FontSize="16"/>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,5,0,0"
                                               Text="{Binding DeviceId}"
                                               Opacity="0.65"/>
                                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding State}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding StationId}"
                                                   Opacity="0.5"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Margin="12,0,0,0"
                    Background="White" Padding="16" CornerRadius="10"
                    BorderBrush="#E1E5EB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="اتصال به ایستگاه"
                               FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedAgentText"
                               Margin="0,12,0,8"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="ایستگاه مقصد"/>
                    <ComboBox x:Name="StationBox" Height="36"
                              Margin="0,6,0,0"/>
                    <Button x:Name="BindButton"
                            Content="اتصال Agent"
                            Height="38"
                            Margin="0,14,0,0"
                            Click="BindButton_Click"/>
                    <Button Content="بازخوانی"
                            Height="36"
                            Margin="0,8,0,0"
                            Click="RefreshButton_Click"/>
                    <TextBlock x:Name="StatusText"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Text="DeviceId هویت پایدار دستگاه است؛ IP و ConnectionId فقط مشخصات اتصال هستند."
                   Opacity="0.65"/>
    </Grid>
</Window>
