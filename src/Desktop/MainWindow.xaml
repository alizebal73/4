<Window x:Class="GameNet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameNet Manager 4"
        Width="980"
        Height="620"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="GameNet Manager 4"
                       FontSize="28"
                       FontWeight="SemiBold"
                       DockPanel.Dock="Right" />
            <TextBlock Text="کنترل‌سنتر"
                       Margin="18,8,0,0"
                       FontSize="16" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="14"
                CornerRadius="8"
                BorderBrush="#D0D4DC"
                BorderThickness="1"
                Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="وضعیت اتصال:"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Text="در حال بررسی..."
                           Margin="8,0,0,0" />
                <Button Content="بررسی مجدد"
                        Margin="24,0,0,0"
                        Padding="14,5"
                        Click="Refresh_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Padding="22"
                BorderBrush="#D0D4DC"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Slice 0 — Platform Foundation"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="این صفحه عمداً هنوز منطق کسب‌وکار یا دادهٔ ساختگی ندارد. Desktop فقط وضعیت واقعی Server/PostgreSQL را نمایش می‌دهد."
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Text="مرحلهٔ بعد: Authentication + Stations + Agent binding"
                           Margin="0,24,0,0"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
