<Window x:Class="GameNet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameNet Manager 4"
        Width="1200"
        Height="760"
        MinWidth="1100"
        MinHeight="650"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="24" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock FontSize="30" FontWeight="SemiBold" Text="GameNet Manager" />
      <TextBlock Margin="0,8,0,0"
                 FontSize="15"
                 Opacity="0.72"
                 Text="پایهٔ دسکتاپ آماده است؛ قابلیت‌های عملیاتی بعد از تأیید Foundation ساخته می‌شوند." />
    </StackPanel>
    <Border Grid.Row="2"
            Padding="24"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="10">
      <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Foundation" />
        <TextBlock Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="این پنجره عمداً هیچ منطق کسب‌وکاری ندارد. Desktop فقط رابط اپراتور است و حقیقت داده و قوانین در Server نگهداری خواهد شد." />
      </StackPanel>
    </Border>
  </Grid>
</Window>
